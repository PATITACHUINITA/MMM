import flet as ft
import requests
import pygame
import threading

# 🔊 INICIAR PYGAME
pygame.mixer.init()

def sonido_click():
    try:
        pygame.mixer.music.load("https://www.soundjay.com/button/beep-07.wav")
        pygame.mixer.music.play()
    except:
        pass

# 🔹 OBTENER POKEMON
def obtener_pokemon(nombre):
    try:
        url = f"https://pokeapi.co/api/v2/pokemon/{nombre.lower()}"
        res = requests.get(url, verify=False)

        if res.status_code != 200:
            return None
        
        data = res.json()

        return {
            "nombre": data["name"],
            "id": data["id"],
            "altura": data["height"],
            "peso": data["weight"],
            "xp": data["base_experience"],
            "imagen": data["sprites"]["other"]["official-artwork"]["front_default"],
            "tipos": [t["type"]["name"] for t in data["types"]]
        }
    except:
        return None

# 🔹 APP
def main(page: ft.Page):
    page.title = "Pokédex Flet 🔥"
    page.theme_mode = "dark"

    titulo = ft.Text("🔴 Pokédex con Flet", size=30, weight="bold")

    input_busqueda = ft.TextField(label="Buscar Pokémon", width=300)

    resultado = ft.Column()

    def buscar(e):
        nombre = input_busqueda.value
        pokemon = obtener_pokemon(nombre)

        resultado.controls.clear()

        if not pokemon:
            resultado.controls.append(ft.Text("❌ No encontrado"))
        else:
            threading.Thread(target=sonido_click).start()

            resultado.controls.append(
                ft.Column([
                    ft.Text(pokemon["nombre"].upper(), size=25),
                    ft.Image(src=pokemon["imagen"], width=200),
                    ft.Text(f"ID: {pokemon['id']}"),
                    ft.Text(f"Altura: {pokemon['altura']}"),
                    ft.Text(f"Peso: {pokemon['peso']}"),
                    ft.Text(f"XP: {pokemon['xp']}"),
                    ft.Text(f"Tipos: {', '.join(pokemon['tipos'])}")
                ])
            )

        page.update()

    boton = ft.ElevatedButton("Buscar", on_click=buscar)

    page.add(
        ft.Column([
            titulo,
            input_busqueda,
            boton,
            resultado
        ], alignment="center")
    )

# 🔥 EJECUCIÓN (IMPORTANTE SOLO ESTA LÍNEA)
ft.app(target=main, view="web_browser")